# Python
*__pycache__/
*.py[cod]
*.pyo

# Virtual Environment
venv_pro/
.venv/
env/

# Environment variables
.env

# VSCode
.vscode/
.claude/
.langgraph_api/
# NOTE: ".streamlit/*" (not ".streamlit/") so the negation below can still
# apply — a trailing-slash directory rule stops git from descending into it
# at all, which silently defeats any "!" exception for files inside it.
.streamlit/*
!.streamlit/config.toml

*.json
!langgraph.json
# macOS
.DS_Store

# Logs
logs/
*.log

# Chroma DB
chroma_db/

# Local databases
*.db
*.sqlite

# Data folders
# NOTE: chat history (data/chat_state.sqlite3), captured leads
# (data/leads.jsonl), and logs are intentionally NOT tracked here even
# though they need to persist in production — that's handled by mounting
# data/ as a persistent volume in docker-compose.yml instead. Committing a
# live, constantly-changing sqlite file to git would bloat history and
# risks clobbering server data on a future `git pull`.
data/
datasets/
downloads/
# ("collections/" removed — it's a leftover generic-template rule that was
# accidentally matching Qdrant's own qdrant_storage/collections/ directory,
# excluding the entire vector DB from git. No other directory in this repo
# is actually named "collections".)
# Output folders
output/
outputs/

# Models
models/

# Temporary files
tmp/
temp/

# Jupyter
.ipynb_checkpoints/

# PDF files (optional)
*.pdf

# Images (optional)
*.png
*.jpg
*.jpeg
# ...except the app's own branding, which needs to ship with the app.
!logo.png
!PROFXfavicon.png

# Qdrant vector DB data — deliberately tracked so the server can be deployed
# from a git clone/pull without re-running the scraper/ingestion pipeline.
# ~190MB across 123 files as of the last ingestion run, comfortably under
# GitHub's 100MB-per-file limit (a Qdrant *snapshot* of the same collection
# came out to ~500MB in a single file — too large for a plain git push, so
# the raw storage directory is the better fit here). Re-run `python
# run_ingest.py` and re-commit this directory if the catalog changes.
!qdrant_storage/**/*.json
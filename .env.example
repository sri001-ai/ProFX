# Copy this file to .env and fill in the values you need.

# Chat LLM — Gemini is the primary model, Claude and OpenAI are automatic
# fallbacks if Gemini errors out (rate limit, outage, etc). All three keys
# are required since any of them could end up serving a given request.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LangSmith observability (https://smith.langchain.com) — get an API key from
# your LangSmith account settings. Tracing stays off unless both are set.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=profx-agentic-rag

# Everything else (Qdrant URL, embedding model, chunk sizes, guardrail/
# reranker flags, top-k values, chat model names...) has sane defaults —
# see config.py for the full list of PROFX_* / QDRANT_* / OLLAMA_* /
# GEMINI_MODEL / CLAUDE_MODEL / OPENAI_MODEL overrides.
